# Pexels API key (선택 — stock 이미지)
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay API key (선택 — stock 이미지 추가)
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# TMDB API key (선택 — 영화·드라마 스틸, 시네마틱 톤)
# https://www.themoviedb.org/settings/api  → "API 키" (짧은 16진수)
TMDB_API_KEY=

# 레퍼런스 저장 폴더 (선택, 기본: ~/refs)
REFS_OUTPUT_DIR=
